# このファイルをコピーして .env.local を作成し、実際の値を設定すること。
# .env.local はコミットしないこと（.gitignoreで除外済み）。
#
#   cp .env.example .env.local

# --- Supabase --------------------------------------------------------------
# Supabaseダッシュボード > Project Settings > Data API で確認できる値。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。Project Settings > API Keys の service_role。絶対にNEXT_PUBLIC_を付けないこと。
SUPABASE_SERVICE_ROLE_KEY=

# --- Prisma / DB接続 ---------------------------------------------------------
# Supabaseダッシュボード > Project Settings > Database > Connection string。
# DATABASE_URL: アプリからの通常アクセス用（Transaction pooler / pgbouncer, ポート6543、末尾に ?pgbouncer=true）
# DIRECT_URL:   マイグレーション実行専用の直接接続（Session/Direct, ポート5432）
DATABASE_URL=
DIRECT_URL=

# --- Google Maps -------------------------------------------------------------
# Google Cloud Console で取得したGoogle Maps JavaScript APIキー（F4以降で使用）。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
